{
  "name": "sfra",
  "version": "7.0.0",
  "description": "Storefront Reference Architecture",
  "main": "index.js",
  "engines": {
    "node": ">=4.0"
  },
  "scripts": {
    "test": "sgmf-scripts --test test/unit/**/*.js",
    "cover": "sgmf-scripts --cover 'test/unit'",
    "test:integration": "sgmf-scripts --integration 'test/integration/**/*.js'",
    "test:acceptance:custom": "npx codeceptjs run --plugins retryFailedStep --profile",
    "test:acceptance:deep": "npx codeceptjs run --plugins retryFailedStep --grep '(?=.*)^(?!.*@mobile)^(?!.*@tablet)^(?!.*@pageDesigner)' --profile",
    "test:acceptance:smoke": "npx codeceptjs run --plugins retryFailedStep --grep @happyPath --profile",
    "test:acceptance:pagedesigner": "npx codeceptjs run --plugins retryFailedStep --grep @pageDesigner --profile",
    "test:acceptance:desktop": "npx codeceptjs run --plugins retryFailedStep --grep '(?=.*)^(?!.*@mobile)^(?!.*@tablet)^(?!.*@pageDesigner)^(?!.*@deepTest)' --profile",
    "test:acceptance:mobile": "npx codeceptjs run --plugins retryFailedStep --profile sauce:phone --grep @mobile",
    "test:acceptance:tablet": "npx codeceptjs run --plugins retryFailedStep --profile sauce:tablet --grep @tablet",
    "test:acceptance:parallel": "npx codeceptjs run-multiple parallel --plugins retryFailedStep --profile",
    "test:acceptance:multibrowsers": "npx codeceptjs run-multiple multibrowsers --plugins retryFailedStep --profile",
    "test:acceptance:report": "./node_modules/.bin/allure serve test/acceptance/report",
    "bdd:snippets": "./node_modules/.bin/codeceptjs bdd:snippets --path",
    "compile:fonts": "node bin/Makefile compileFonts",
    "wp:watch": "cross-env NODE_ENV=development webpack --watch",
    "wp:watch:core": "cross-env NODE_ENV=development SITE=app_storefront_core webpack --watch",
    "wp:dev": "cross-env NODE_ENV=development webpack",
    "wp:prd": "cross-env NODE_ENV=production webpack",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "sgmf-scripts --lint css",
    "lint:js": "sgmf-scripts --lint js",
    "build-atlas": "atlas-guide --build=./cartridges/app_storefront_core/.atlasrc.json",
    "compile:icons": "node ./bin/IconFont.js --site app_storefront_core",
    "upload": "sgmf-scripts --upload",
    "uploadBMCartridges": "sgmf-scripts --uploadCartridge bc_job_components && sgmf-scripts --uploadCartridge bm_app_storefront_base && sgmf-scripts --uploadCartridge bm_app_storefront_core && sgmf-scripts --uploadCartridge bm_checkoutcom",
    "uploadSiteCartridges": "sgmf-scripts --uploadCartridge app_storefront_base && sgmf-scripts --uploadCartridge modules && sgmf-scripts --uploadCartridge app_storefront_core && sgmf-scripts --uploadCartridge int_checkoutcom_overlay && sgmf-scripts --uploadCartridge int_checkoutcom_sfra && sgmf-scripts --uploadCartridge int_unifonic && sgmf-scripts --uploadCartridge plugin_dis",
    "uploadAllCartridges": "npm run uploadBMCartridges && npm run uploadSiteCartridges",
    "library:build": "node ./bin/libraryMerge.js --path=/../site_template/",
    "library:page": "node ./bin/libraryExtractPage.js --path=/../site_template/"
  },
  "devDependencies": {
    "@babel/core": "^7.6.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.6.2",
    "@babel/preset-env": "^7.6.3",
    "@tridnguyen/config": "^2.3.1",
    "@wdio/selenium-standalone-service": "^7.31.1",
    "allure-commandline": "^2.17.2",
    "appium": "^1.15.0",
    "async": "^3.2.3",
    "atlas-guide": "^2.2.6",
    "babel-core": "^6.26.3",
    "babel-loader": "^8.0.6",
    "babel-preset-env": "^1.7.0",
    "chai": "^3.5.0",
    "chai-subset": "^1.6.0",
    "chalk": "^1.1.3",
    "cheerio": "0.22.0",
    "cldr-data": "^36.0.1",
    "clean-webpack-plugin": "^1.0.0",
    "codeceptjs": "^3.5.11",
    "codeceptjs-cucumber": "^2.0.10",
    "codeceptjs-saucehelper": "^1.4.0",
    "codeceptjs-saucelabs": "^2.0.6",
    "codeceptjs-shared": "^2.0.6",
    "command-line-args": "^5.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.0.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^4.1.10",
    "debug": "^4.1.1",
    "deepmerge": "^3.3.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-sitegenesis": "~1.0.0",
    "events": "^3.1.0",
    "fs-extra": "^7.0.1",
    "glob": "^7.1.3",
    "globalize": "^1.4.2",
    "husky": "^4.2.5",
    "isml-linter": "^5.26.4",
    "istanbul": "^0.4.5",
    "lodash": "^4.17.15",
    "mini-css-extract-plugin": "^2.7.6",
    "minimatch": "^3.0.4",
    "minimist": "^1.2.6",
    "mocha": "^10.0.0",
    "mocha-junit-reporter": "^2.0.2",
    "moment-timezone": "^0.5.26",
    "nyc": "^15.1.0",
    "postcss-loader": "^7.0.0",
    "prettier": "3.0.0",
    "properties-parser": "^0.3.1",
    "proxyquire": "1.7.4",
    "request-promise": "^4.2.6",
    "rtlcss": "^3.0.0",
    "sass": "^1.69.7",
    "sass-loader": "^13.3.2",
    "select2": "^4.1.0-rc.0",
    "selenium-standalone": "^9.5.0",
    "sgmf-scripts": "^3.0.0",
    "shelljs": "^0.8.5",
    "should": "^13.2.3",
    "sinon": "^17.0.1",
    "style-loader": "^0.21.0",
    "stylelint": "^15.4.0",
    "stylelint-config-standard": "^31.0.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "stylelint-scss": "^5.3.2",
    "terser-webpack-plugin": "^5.3.10",
    "url": "^0.11.0",
    "wdio-sauce-service": "^0.4.14",
    "webdriverio": "^7.30.0",
    "webfont": "^9.0.0",
    "webpack-cli": "^5.1.4",
    "webpack-remove-empty-scripts": "^1.0.4",
    "webpack-rtl-plugin": "^2.0.0",
    "webpack-sources": "2.2.0",
    "xml-formatter": "^2.4.0",
    "xml2js": "^0.4.22",
    "bestzip": "^2.2.1",
    "shx": "^0.3.4"
  },
  "config": {
    "commitMessageRegex": "^[A-Z0-9]{2,10}-[0-9]{1,5}:(FIX|CHANGE|ADD): [a-zA-Z0-9 \\.,\\'\"\\[\\]]+|^(Merge|Revert|Finish).+",
    "commitMessageComment": "Your message format is slightly different than required. 'Please use 'TICKET-ID:TYPE: Comment' format. Ex. 'DER-123:ADD: Added cookie banner'"
  },
  "dependencies": {
    "autoprefixer": "^10.4.14",
    "body-scroll-lock": "^3.0.3",
    "bootstrap": "^4.6.2",
    "cleave.js": "^1.5.3",
    "flag-icon-css": "^2.9.0",
    "flag-icons": "7.1.0",
    "font-awesome": "^4.7.0",
    "html2pdf.js": "^0.10.1",
    "jquery": "^3.5.1",
    "jspdf": "^2.5.1",
    "node-sass-json-importer": "^4.1.0",
    "platform": "^1.3.6",
    "qrcode": "^1.5.1",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.1.4",
    "vanilla-lazyload": "^17.3.1"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ],
  "babel": {
    "presets": [
      "env"
    ]
  }
}
